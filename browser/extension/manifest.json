{
  "manifest_version": 3,
  "name": "Agent Browser",
  "version": "0.2.0",
  "description": "Claude agent in your browser's side panel: it reads pages, clicks, types and fills forms for you, replays what it learnt as recipes, watches pages for changes and remembers each site.",
  "key": "",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "privacy",
    "unlimitedStorage",
    "cookies",
    "downloads",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Agent Browser",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob:; frame-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
