{
  "manifest_version": 3,
  "name": "Agent Browser",
  "version": "0.1.0",
  "description": "Claude agent in your browser's side panel — reads pages, clicks, types and switches tabs for you. Works right in the extension with your API key.",
  "key": "",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "tabs",
    "scripting",
    "storage",
    "debugger",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "privacy",
    "unlimitedStorage",
    "cookies",
    "downloads",
    "downloads.open"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Agent Browser",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob:; frame-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["fp-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject-fingerprint.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
