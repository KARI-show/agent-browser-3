[Unit]
Description=Agent IDE Queue Manager
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/queue-manager
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
Environment=PORT=80
Environment=MODELS=claude-haiku-4-5,claude-sonnet-5-5,claude-opus-5-5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
